# Server
APP_ENV=development
APP_PORT=8080
APP_NAME=AgriFleet

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agrifleet
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agrifleet
MINIO_USE_SSL=false

# FCM
FCM_SERVER_KEY=your-fcm-server-key

# CORS
CORS_ORIGINS=*
